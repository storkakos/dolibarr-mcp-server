# TEST ONLY. Template of the LibreChat v0.8.9 config of the test stack. Compose renders it when the
# container starts into /tmp/librechat.yaml (CONFIG_PATH) and replaces only __LITELLM_MODEL__ with the
# value of LITELLM_MODEL, because LibreChat does not substitute ${...} in model names. Key and base URL
# stay ${...}. Twin: itop-mcp-server test-infra 09 (same idea, its own render step, no shared script).
# The config: the snippets of
# docs/setup/example-keycloak-librechat.md, plus one AI model (not part of the example setup).
version: 1.3.19

# --- Your LLM endpoint (not part of the example setup). The test stack uses the shared LiteLLM endpoint:
# key, base URL and model come from the key file (llm.env, or LLM_ENV_FILE) as LITELLM_KEY,
# LITELLM_BASE_URL and LITELLM_MODEL; compose passes that file to LibreChat. For another provider or
# model, change this block, the variables in the key file and the preset below. Use a model that
# supports tool calls.
endpoints:
  custom:
    - name: LiteLLM
      apiKey: "${LITELLM_KEY}"
      baseURL: "${LITELLM_BASE_URL}"
      models:
        default: ["__LITELLM_MODEL__"]
        fetch: false
      titleConvo: false

# --- From the example setup, section "librechat.yaml: the Dolibarr MCP server"
mcpServers:
  dolibarr:
    type: streamable-http
    # Exactly the MCP server's MCP_RESOURCE_URL.
    url: https://mcp.example.com/mcp
    title: Dolibarr
    description: Third parties, invoices, proposals, orders and products from Dolibarr, with your own Dolibarr rights
    # Every user connects with their own Dolibarr account.
    requiresOAuth: true

mcpSettings:
  allowedDomains:
    - "https://mcp.example.com"
    - "https://erp.example.com"

# With the option "Dolibarr assistant preselected" (prioritize, enforce, default).
modelSpecs:
  prioritize: true
  enforce: false
  list:
    - name: dolibarr-assistant
      default: true
      label: Dolibarr assistant
      description: Answers questions about Dolibarr with your own Dolibarr rights
      preset:
        # Your endpoint and model (see above).
        endpoint: LiteLLM
        model: __LITELLM_MODEL__
      mcpServers:
        - dolibarr
