# Dolibarr MCP server configuration. Copy to .env and fill in the REQUIRED values.
# The server refuses to start when a required value is missing or a value is malformed; the
# message names the setting. There is no fallback to a local Dolibarr.

# --- Required ---------------------------------------------------------------------------

# REQUIRED. Base URL of your Dolibarr, without a trailing slash. The server calls the REST API
# under <DOLIBARR_URL>/api/index.php (restoauth/me, restoauth/endpoints and the read endpoints).
DOLIBARR_URL=https://erp.example.com

# REQUIRED. Issuer of the restoauth module (the authorization server), exactly as the restoauth
# setup page in Dolibarr shows it. With the default Dolibarr layout this is
# <DOLIBARR_URL>/custom/restoauth. The protected resource metadata points MCP clients here.
DOLIBARR_OAUTH_ISSUER=https://erp.example.com/custom/restoauth

# REQUIRED. Public URL of this MCP server, as MCP clients reach it through your reverse proxy.
# Must be one of the allowed resources configured in restoauth (RFC 8707). The protected resource
# metadata and the 401 challenge advertise this URL, never the bind address. The proxy must pass the
# original Host header through: only the host (and port) of this URL and loopback are accepted.
# Any other Host header gets 421, and an Origin header other than this URL's origin or loopback
# gets 403, on every path and before the token is checked, so such a request never reaches Dolibarr.
MCP_RESOURCE_URL=https://mcp.example.com/mcp

# --- Optional ---------------------------------------------------------------------------

# Maximum number of rows a single tool call fetches from Dolibarr (1-10000). Default: 50
#MCP_MAX_ROWS=50

# How long the result of restoauth/me (user, rights, token expiry) is kept in memory per token,
# in seconds (0-3600, 0 = ask Dolibarr on every call). A revoked token or a changed right takes
# effect after at most this long. Default: 30
#MCP_RIGHTS_CACHE_SECONDS=30

# Audit log (JSON lines, one line per tool call, never the token itself). Default:
# /data/logs/mcp-dolibarr-audit.log. The folder must be writable, or the server refuses to start.
#MCP_AUDIT_LOG=/data/logs/mcp-dolibarr-audit.log

# Listen address and port. Defaults: 0.0.0.0 (all interfaces) and 8131.
#MCP_HOST=0.0.0.0
#MCP_PORT=8131

# Internal CA: CA bundle (PEM) to verify Dolibarr's HTTPS certificate, as a path INSIDE the container.
# Only needed if Dolibarr's certificate is issued by your own CA. Mount the file read-only into the
# container and set this to the mount target. The bundle replaces the built-in list of public CAs,
# so it must contain the CA that issued Dolibarr's certificate (root, plus intermediates if Dolibarr
# does not send them). A missing, unreadable or empty bundle stops startup. Certificate verification
# is never turned off. Default: unset (the built-in public CAs)
#SSL_CERT_FILE=/etc/dolibarr-mcp/ca.pem
